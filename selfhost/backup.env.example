# Настройки копий базы CRM. Скопировать в /etc/crm-backup.env и закрыть: chmod 600
# При переезде на другой VPS достаточно перенести этот файл и скрипты из selfhost/.

# Подключение к базе (то же, что в .env приложения)
DATABASE_URL=postgresql://crm:ПАРОЛЬ@127.0.0.1:5432/crm

# Пароль шифрования копий. ХРАНИТЕ ОТДЕЛЬНО ОТ СЕРВЕРА — без него копию не восстановить.
BACKUP_PASSPHRASE=

# Внешнее хранилище
S3_BUCKET=
S3_PREFIX=crm-backups

# Вариант А: обычные ключи AWS (нужен установленный aws cli)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# Вариант Б: выгрузка через Lovable (ключи AWS на сервере не лежат)
LOVABLE_API_KEY=
AWS_S3_API_KEY=

# Ежедневный отчёт на почту (необязательно)
REPORT_EMAIL=
REPORT_FROM=onboarding@resend.dev
RESEND_API_KEY=

# Сколько дневных копий держать локально
KEEP_DAILY=14
