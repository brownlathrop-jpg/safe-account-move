# Скопируйте в .env и заполните. Сам .env в репозиторий не попадает.

# --- приложение ---
SESSION_SECRET=            # openssl rand -hex 32 (смена = выход всех пользователей)
APP_URL=https://crm.skladnow.ru

# --- база данных ---
